# ==========================================
# Cardano Bounties Environment Variables
# ==========================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for Session Verification
JWT_SECRET=your-jwt-secret-string

# Vercel Cron Secret (for /api/cron/expire-bounties)
CRON_SECRET=your-cron-secret-token

# Blockfrost API Configuration
BLOCKFROST_PROJECT_ID=preprodYourBlockfrostProjectId
NEXT_PUBLIC_BLOCKFROST_NETWORK=preprod

# Escrow Address on Cardano Preprod Testnet
NEXT_PUBLIC_ESCROW_ADDRESS=addr_test1...

# LocalStorage Keys for Wallet & Auth
NEXT_PUBLIC_STORAGE_WALLET_KEY=cardano_wallet_id
NEXT_PUBLIC_STORAGE_TOKEN_KEY=cardano_auth_token

# Platform Admin Contact (Optional)
NEXT_PUBLIC_CONTACT_EMAIL=admin@cardanobounties.io
